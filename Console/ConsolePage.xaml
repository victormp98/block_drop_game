<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlockDrop.ConsoleUI.ConsolePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#C6C6C8"
             SafeAreaEdges="Container">
    <ContentPage.Resources>
        <Style x:Key="ConsoleButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#202023" />
            <Setter Property="TextColor" Value="#E4E4E6" />
            <Setter Property="BorderColor" Value="#111113" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="MinimumWidthRequest" Value="44" />
        </Style>
        <Style x:Key="CaseLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#4E4E54" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.5" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="ConsoleLayout" Padding="16,14,16,10" RowDefinitions="*,Auto,Auto" RowSpacing="10">
        <Border x:Name="ScreenBezel" Grid.Row="0" BackgroundColor="#707076"
                Stroke="#59595F" StrokeThickness="2" Padding="12,10,12,14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14,14,14,38" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="DOT MATRIX • MONOCHROME" FontSize="9" CharacterSpacing="1.3"
                           TextColor="#E1E1E3" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                        <Border WidthRequest="7" HeightRequest="7" StrokeThickness="0"
                                BackgroundColor="#D9D9DB" StrokeShape="RoundRectangle 4" />
                        <Label Text="POWER" FontSize="8" TextColor="#E1E1E3" />
                    </HorizontalStackLayout>
                </Grid>
                <Border Grid.Row="1" Stroke="#39393D" StrokeThickness="3" BackgroundColor="#C8C8BE"
                        StrokeShape="RoundRectangle 2">
                    <GraphicsView x:Name="ScreenView" BackgroundColor="#C8C8BE"
                                  EndInteraction="OnScreenTapped"
                                  SemanticProperties.Description="Pantalla de BlockDrop. Usa la cruceta para elegir y A o START para confirmar." />
                </Border>
                <Label Grid.Row="2" x:Name="ScreenCaptionLabel" Text="POCKET GAME SYSTEM" FontSize="8"
                       CharacterSpacing="1.4" TextColor="#D1D1D5" HorizontalTextAlignment="Center" />
            </Grid>
        </Border>

        <Grid x:Name="ControlsPanel" Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="BlockDrop" FontSize="21" FontAttributes="Bold,Italic" TextColor="#414147" />
                    <Label Text="POCKET" Style="{StaticResource CaseLabel}" VerticalOptions="End" Margin="0,0,0,4" />
                </HorizontalStackLayout>
                <Label Grid.Column="1" Text="01" Style="{StaticResource CaseLabel}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="2,4">
                <Grid x:Name="DPad" RowDefinitions="44,44,44" ColumnDefinitions="44,44,44"
                      RowSpacing="0" ColumnSpacing="0" HorizontalOptions="Start" VerticalOptions="Center">
                    <Button Grid.Row="0" Grid.Column="1" Text="▲" Style="{StaticResource ConsoleButton}"
                            Clicked="OnUpClicked" SemanticProperties.Description="Arriba: acción del juego o subir en el menú" />
                    <Button x:Name="LeftButton" Grid.Row="1" Grid.Column="0" Text="◀" Style="{StaticResource ConsoleButton}"
                            Pressed="OnDirectionPressed" Released="OnDirectionReleased" CommandParameter="left"
                            SemanticProperties.Description="Izquierda. Mantén pulsado para repetir." />
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#202023" StrokeThickness="0" Padding="12">
                        <Border BackgroundColor="#2C2C30" Stroke="#111113" StrokeThickness="1" StrokeShape="RoundRectangle 10" />
                    </Border>
                    <Button x:Name="RightButton" Grid.Row="1" Grid.Column="2" Text="▶" Style="{StaticResource ConsoleButton}"
                            Pressed="OnDirectionPressed" Released="OnDirectionReleased" CommandParameter="right"
                            SemanticProperties.Description="Derecha. Mantén pulsado para repetir." />
                    <Button x:Name="DownButton" Grid.Row="2" Grid.Column="1" Text="▼" Style="{StaticResource ConsoleButton}"
                            Pressed="OnDirectionPressed" Released="OnDirectionReleased" CommandParameter="down"
                            SemanticProperties.Description="Abajo: acción del juego o bajar en el menú. Mantén pulsado para repetir." />
                </Grid>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="14" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="5" Margin="0,25,0,0">
                        <Button x:Name="ActionBButton" Text="B" Style="{StaticResource ConsoleButton}" CornerRadius="29"
                                HeightRequest="58" WidthRequest="58" FontSize="23" Clicked="OnBClicked"
                                SemanticProperties.Description="B: acción del juego o volver" />
                        <Label x:Name="ActionBLabel" Text="B" Style="{StaticResource CaseLabel}" HorizontalTextAlignment="Center" FontSize="8" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5" Margin="0,0,0,25">
                        <Button x:Name="ActionAButton" Text="A" Style="{StaticResource ConsoleButton}" CornerRadius="29"
                                HeightRequest="58" WidthRequest="58" FontSize="23" Clicked="OnAClicked"
                                SemanticProperties.Description="A: acción del juego o confirmar" />
                        <Label x:Name="ActionALabel" Text="A" Style="{StaticResource CaseLabel}" HorizontalTextAlignment="Center" FontSize="8" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="BottomPanel" Grid.Row="2" ColumnDefinitions="*,Auto" Padding="0,0,6,2">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Padding="28,0,0,0">
                <Button Text="SELECT" Style="{StaticResource ConsoleButton}" CornerRadius="16"
                        WidthRequest="76" HeightRequest="44" FontSize="9" CharacterSpacing="1"
                        Clicked="OnSelectClicked" SemanticProperties.Description="SELECT: menú principal" />
                <Button Text="START" Style="{StaticResource ConsoleButton}" CornerRadius="16"
                        WidthRequest="76" HeightRequest="44" FontSize="9" CharacterSpacing="1"
                        Clicked="OnStartClicked" SemanticProperties.Description="START: jugar, pausar o continuar" />
            </HorizontalStackLayout>
            <HorizontalStackLayout x:Name="Speaker" Grid.Column="1" Spacing="5" Rotation="-20" VerticalOptions="Center">
                <BoxView Color="#909095" WidthRequest="4" HeightRequest="30" CornerRadius="2" />
                <BoxView Color="#909095" WidthRequest="4" HeightRequest="34" CornerRadius="2" />
                <BoxView Color="#909095" WidthRequest="4" HeightRequest="38" CornerRadius="2" />
                <BoxView Color="#909095" WidthRequest="4" HeightRequest="34" CornerRadius="2" />
                <BoxView Color="#909095" WidthRequest="4" HeightRequest="30" CornerRadius="2" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
