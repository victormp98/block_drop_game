<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Console/ScreenChecks.cs" />
    <Compile Include="../Games/**/*.cs" Link="Games/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Shared/Contracts/*.cs" Link="Shared/Contracts/%(Filename)%(Extension)" />
    <Compile Include="../Shared/Graphics/*.cs" Link="Shared/Graphics/%(Filename)%(Extension)" />
    <Compile Include="../Console/ConsoleViewState.cs" Link="Console/ConsoleViewState.cs" />
    <Compile Include="../Console/ConsoleScreen.cs" Link="Console/ConsoleScreen.cs" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.20" />
  </ItemGroup>
</Project>
